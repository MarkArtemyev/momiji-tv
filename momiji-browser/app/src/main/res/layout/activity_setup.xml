<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/setup_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="40dp"
        android:paddingEnd="64dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_leaf" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="@string/agent_title"
                android:textColor="@color/cream"
                android:textSize="32sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/agent_subtitle"
            android:textColor="@color/hint"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/panel"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/status_service"
                style="@style/SetupRow" />

            <TextView
                android:id="@+id/status_key"
                style="@style/SetupRow" />

            <TextView
                android:id="@+id/status_button"
                style="@style/SetupRow" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:clipChildren="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_service"
                style="@style/Chip"
                android:text="@string/agent_btn_service" />

            <TextView
                android:id="@+id/btn_button"
                style="@style/Chip"
                android:text="@string/agent_btn_button" />

            <TextView
                android:id="@+id/btn_voice"
                style="@style/Chip"
                android:drawableStart="@drawable/ic_mic"
                android:text="@string/agent_btn_voice" />

            <TextView
                android:id="@+id/btn_test"
                style="@style/Chip"
                android:text="@string/agent_btn_test" />
        </LinearLayout>

        <TextView
            android:id="@+id/key_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/cream"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/model_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/hint"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
