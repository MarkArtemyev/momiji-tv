<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Momiji" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/dusk</item>
        <item name="android:colorAccent">@color/amber</item>
        <item name="android:colorPrimary">@color/maple</item>
        <item name="android:colorPrimaryDark">@color/dusk</item>
    </style>

    <style name="Theme.Momiji.Voice" parent="@android:style/Theme.Translucent.NoTitleBar.Fullscreen">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">false</item>
    </style>

    <style name="SetupRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">@color/cream</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:textColor">@color/chip_fg</item>
        <item name="android:drawableTint">@color/chip_fg</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:singleLine">true</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
