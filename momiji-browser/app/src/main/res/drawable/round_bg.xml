<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="@color/persimmon"
                android:startColor="@color/amber" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#1FFFF3E0" />
            <stroke
                android:width="1dp"
                android:color="#44FFB347" />
        </shape>
    </item>
</selector>
