<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="0"
                android:endColor="@color/persimmon"
                android:startColor="@color/amber" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#1FFFF3E0" />
            <stroke
                android:width="1dp"
                android:color="#26FFF3E0" />
        </shape>
    </item>
</selector>
